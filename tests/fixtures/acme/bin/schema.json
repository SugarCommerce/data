{
  "widgets": {
    "singular": "widget",
    "alias": "w",
    "uuid": false,
    "meta": true,
    "why": "Something sold, with a count of how often.",
    "columns": [
      { "name": "name", "type": "varchar", "length": 100, "default": "", "searchable": true, "sortable": true },
      { "name": "status", "type": "varchar", "length": 20, "default": "active", "sortable": true, "index": true },
      { "name": "price", "type": "bigint", "length": 20, "unsigned": false, "default": "0", "sortable": true },
      { "name": "currency", "type": "char", "length": 3, "default": "", "default_function": "acme_get_default_currency" },
      { "name": "use_count", "type": "int", "length": 11, "unsigned": true, "default": "0" },
      { "name": "date_sold", "type": "datetime", "allow_null": true, "sortable": true }
    ]
  },
  "events": {
    "singular": "event",
    "alias": "e",
    "uuid": false,
    "meta": false,
    "why": "Something that must be handled once: unique on its reference.",
    "columns": [
      { "name": "event_ref", "type": "varchar", "length": 100, "default": "", "unique": true },
      { "name": "status", "type": "varchar", "length": 20, "default": "pending", "index": true },
      { "name": "attempts", "type": "smallint", "length": 6, "unsigned": true, "default": "0" },
      { "name": "error", "type": "text" },
      { "name": "payload", "type": "longtext" }
    ]
  },
  "counters": {
    "singular": "counter",
    "alias": "c",
    "uuid": false,
    "meta": false,
    "why": "How many times something has been tried lately, one row a name.",
    "columns": [
      { "name": "bucket", "type": "char", "length": 64, "default": "", "unique": true },
      { "name": "hits", "type": "int", "length": 11, "unsigned": true, "default": "0" },
      { "name": "date_expires", "type": "datetime", "allow_null": true, "index": true }
    ]
  }
}
