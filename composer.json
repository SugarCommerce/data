{
  "name": "sugarcommerce/data",
  "description": "Custom tables for WordPress plugins as registered components on BerlinDB, with function defaults, stable paging, race-free writes, bounded clean-ups and self-repairing installs.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/data",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "keywords": [
    "wordpress",
    "berlindb",
    "custom-tables",
    "database",
    "components",
    "registry",
    "install"
  ],
  "require": {
    "php": ">=8.3",
    "berlindb/core": "dev-master"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.5",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4",
    "wp-phpunit/wp-phpunit": "^7.1",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "SugarCommerce\\Data\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\Data\\Tests\\": "tests/",
      "Acme\\Database\\": "tests/fixtures/acme/src/Database/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php",
      "/tests/wp-tests-config.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  },
  "support": {
    "issues": "https://github.com/sugarcommerce/data/issues",
    "source": "https://github.com/sugarcommerce/data"
  }
}
